rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada ejecutivo solo puede leer y escribir su propia cartera: usuarios/{su uid}/...
    // Los usuarios se crean en Firebase → Authentication (el registro público está desactivado).
    match /usuarios/{uid}/{coleccion}/{id} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && coleccion in ['clientes', 'tramites', 'agenda', 'historial', 'simulaciones'];
    }
    // Normas internas del banco (parámetros de la calculadora): las lee cualquier usuario con sesión,
    // solo el administrador (17751) puede cargarlas o actualizarlas.
    match /config/{doc} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == '17751@mi-cartera-bmsc.app';
    }
    // Cartera compartida anterior: solo el usuario 17751 puede leerla y borrarla,
    // para que la app la mueva a su cartera. Se puede quitar cuando esté vacía.
    match /{coleccion}/{id} {
      allow read, delete: if request.auth != null
        && request.auth.token.email == '17751@mi-cartera-bmsc.app'
        && coleccion in ['clientes', 'tramites', 'agenda', 'historial'];
    }
  }
}
