rules_version = '2';
// Solo el usuario 17751 (creado en Firebase → Authentication) puede leer y escribir.
// Para agregar otro ejecutivo: crear su usuario en Authentication y sumar su correo a la lista.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coleccion}/{id} {
      allow read, write: if request.auth != null
        && request.auth.token.email in ['17751@mi-cartera-bmsc.app']
        && coleccion in ['clientes', 'tramites', 'agenda', 'historial'];
    }
  }
}
